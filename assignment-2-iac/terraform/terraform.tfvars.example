# ============================================
# Example Terraform Variables
# Copy this file to terraform.tfvars and customize
# 复制此文件到 terraform.tfvars 并自定义
# ============================================

# Resource Group Configuration
resource_group_name = "rg-assignment2-iac"
location            = "norwayeast"  # Options: austriaeast, norwayeast, italynorth

# Storage Account Configuration
storage_account_name     = "stassignment2iac"  # Must be globally unique!
account_tier             = "Standard"
account_replication_type = "ZRS"  # Zone-Redundant Storage

# Tags
common_tags = {
  Environment = "Development"
  Assignment  = "2-IaC"
  ManagedBy   = "Terraform"
  Course      = "Cloud-Computing"
  # Student     = "your-student-id"  # Uncomment and add your ID if needed
}